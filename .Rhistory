### R Data Structures ------
## Vectors -----
# create vectors of data for three medical patients
name <- c("John", "Jane", "Steve")
temp <- c(98.1, 98.6, 101.4)
flu_status <- c(FALSE, FALSE, TRUE)
## examples of accessing items in vector
temp
# access the second element in body temperature vector
temp[2]
# include items in the range 2 to 3
temp[2:3]
# exclude item 2 using the minus sign
temp[c(1,3)]
temp[-2]
# use a vector to indicate whether to include item
temp[c(TRUE, TRUE, FALSE)]
# use a vector to indicate whether to include item
temp[flu_status]
# some arithmetic on vectors. Convert to Celsius
temp_c <- (temp-32)*(5/9)
temp_c
# length of a vector
length(temp)
## Factors -----
# create blood type factor
blood <- factor(c("O", "AB", "A"))
blood   # See contents of factor
# Specify an optional vector of the possible 'levels'
blood <- factor(c("O", "AB", "A"), levels = c("A", "B", "AB", "O"))
blood   # See contents of factor
# add ordered factor
symptoms <- factor(c("SEVERE", "MILD", "MODERATE"),
levels = c("MILD", "MODERATE", "SEVERE"),
ordered = TRUE)
symptoms   # print object
symptoms >= "MODERATE"  # list symptoms greater than moderate
## Data frames -----
# create a data frame from medical patient data
pt_data <- data.frame(name, temp, flu_status, gender,
blood, symptoms, stringsAsFactors = FALSE) #Don't convert character vectors to factors
