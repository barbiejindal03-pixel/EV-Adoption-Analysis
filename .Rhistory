table(df$label)
### QUESTION 1 – Dataset Description ###
library(dplyr)
# Structure
print(str(df))
# Number of rows and columns
print(paste("Number of rows:", nrow(df)))
print(paste("Number of columns:", ncol(df)))
# Column names
print(colnames(df))
# Label distribution
print("Label distribution:")
print(table(df$label))
# Text-length statistics
df$text_len <- nchar(df$text)
print("Summary of text lengths:")
print(summary(df$text_len))
print(paste("Average length:", mean(df$text_len)))
print(paste("Median length:", median(df$text_len)))
print(paste("Minimum length:", min(df$text_len)))
print(paste("Maximum length:", max(df$text_len)))
#q2
### Install required packages (Run only once)
# install.packages("tm")
# install.packages("SnowballC")
# Load libraries
library(tm)          # Text Mining package; tutorial posted on Canvas
library(SnowballC)   # Interface to C 'libstemmer' implementing Porter stemmer
# The TM package requires the text to be organized in a corpus format.
# We take the dataframe and convert it into a VCorpus object.
corp <- VCorpus(DataframeSource(
data.frame(doc_id = df$doc_id, text = df$text, stringsAsFactors = FALSE)
))
# Strip extra whitespace
corp <- tm_map(corp, stripWhitespace)
# Remove punctuation
corp <- tm_map(corp, removePunctuation)
# 3. Convert to lowercase
# TM requires content_transformer for custom transformations
corp <- tm_map(corp, content_transformer(tolower))
#Compute Term–Document Matrix (TDM)
#Rows = Terms, Columns = Documents
#By default, computes term frequency (TF)
tdm <- TermDocumentMatrix(corp)
inspect(tdm)
dtm <- DocumentTermMatrix(corp)
inspect(dtm)
# Stopword Removal
# Removes common English words (the, and, but...) that add no meaning
corp <- tm_map(corp, removeWords, stopwords("english"))
# Recompute DTM after removing stopwords
dtm <- DocumentTermMatrix(corp)
inspect(dtm)
#Stemming
corp <- tm_map(corp, stemDocument)
# Recompute DTM after stemming
dtm <- DocumentTermMatrix(corp)
inspect(dtm)
# Term Frequency – Inverse Document Frequency (TF-IDF)
tfidf <- weightTfIdf(dtm)
inspect(tfidf)
# If any column adds up to zero, drop that term
# (e.g., very frequent terms or stopwords that survived)
#Q3
library(caret)
set.seed(42)  # Reproducibility
#1) Stratified Split of Documents (80/20)
# Preserve class balance of labels (-1 / +1)
# Ensure labels are factors for caret stratification (keep original mapping)
y <- factor(df$label, levels = c(-1, 1), labels = c("-1", "1"))
idx_train <- createDataPartition(y = y, p = 0.80, list = FALSE)
df_train  <- df[idx_train, ]
df_test   <- df[-idx_train, ]
# Quick check
table_train <- table(df_train$label)
table_test  <- table(df_test$label)
print("Label balance (train):"); print(table_train)
print("Label balance (test):");  print(table_test)
# Train corpus
corp_tr <- VCorpus(DataframeSource(
data.frame(doc_id = df_train$doc_id, text = df_train$text, stringsAsFactors = FALSE)
))
corp_tr <- tm_map(corp_tr, stripWhitespace)
corp_tr <- tm_map(corp_tr, removePunctuation)
corp_tr <- tm_map(corp_tr, content_transformer(tolower))
corp_tr <- tm_map(corp_tr, removeWords, stopwords("english"))
corp_tr <- tm_map(corp_tr, stemDocument)
# Test corpus
corp_te <- VCorpus(DataframeSource(
data.frame(doc_id = df_test$doc_id, text = df_test$text, stringsAsFactors = FALSE)
))
corp_te <- tm_map(corp_te, stripWhitespace)
corp_te <- tm_map(corp_te, removePunctuation)
corp_te <- tm_map(corp_te, content_transformer(tolower))
corp_te <- tm_map(corp_te, removeWords, stopwords("english"))
corp_te <- tm_map(corp_te, stemDocument)
#Document–Term Matrices (DTM)
# Train DTM (raw TF). You can add bounds to trim very rare terms if desired.
dtm_tr <- DocumentTermMatrix(corp_tr)
print("Train DTM dims (docs x terms):"); print(dim(dtm_tr))
# Align test DTM to training vocabulary using dictionary=Terms(dtm_tr)
dtm_te <- DocumentTermMatrix(corp_te, control = list(dictionary = Terms(dtm_tr)))
print("Test DTM dims (docs x terms; aligned to train vocab):"); print(dim(dtm_te))
# Targets (y) for Train/Test
y_tr <- factor(df_train$label, levels = c(-1, 1), labels = c("-1", "1"))
y_te <- factor(df_test$label,  levels = c(-1, 1), labels = c("-1", "1"))
# Q4 – Naïve Bayes and SVM Models
# Load libraries
library(naivebayes)
library(e1071)
library(caret)
set.seed(1000)
# Naïve Bayes
# Convert DTM to matrix for modeling
nb_train <- as.matrix(dtm_tr)
nb_test  <- as.matrix(dtm_te)
# Train NB classifier
nb_model <- naive_bayes(x = nb_train,
y = y_tr,
laplace = 1)
# Predict on test data
nb_pred <- predict(nb_model, nb_test)
